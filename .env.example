# The root .env is the only environment file. The pipeline reads it from any folder.
# analysis/.env is ignored. Move its values here.
# Limitless TCG API key (used by the analysis pipeline)
LIMITLESS_API_KEY=

# Firebase web app configuration (used by the React frontend)
VITE_FIREBASE_APIKEY=
VITE_FIREBASE_AUTHDOMAIN=
VITE_FIREBASE_PROJECTID=
VITE_FIREBASE_STORAGEBUCKET=
VITE_FIREBASE_MESSAGINGSENDERID=
VITE_FIREBASE_APPID=

# Optional. Leave blank to use the Chrome Puppeteer downloads on install.
# Lighthouse does not read this variable. Export CHROME_PATH with the same value to run Lighthouse.
PUPPETEER_EXECUTABLE_PATH=
