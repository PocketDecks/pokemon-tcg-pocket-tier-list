{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": ["./**/*", "../src/types/**/*"],
  "exclude": ["node_modules", "dist", "../node_modules"]
}
